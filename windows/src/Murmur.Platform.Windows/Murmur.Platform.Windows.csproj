<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ONLY project in the repo allowed to call Win32. Keep it thin: anything with
         logic in it is code CI cannot exercise. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Murmur.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- This assembly is loaded by reflection, so the app never sees these dependencies
         through a normal project reference. They have to land in this project's output,
         where the publish target picks them up and bundles them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Abstractions\Murmur.Abstractions.csproj" />
  </ItemGroup>
</Project>
